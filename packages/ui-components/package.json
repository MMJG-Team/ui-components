{
    "name": "@mmjg/ui-components",
    "version": "1.0.0-beta.2",
    "description": "A component library for web UI",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "types": {
                "development": "./src/index.ts",
                "production": "./dist/index.d.ts",
                "default": "./src/index.ts"
            },
            "import": {
                "development": "./src/index.ts",
                "production": "./dist/index.js",
                "default": "./src/index.ts"
            }
        }
    },
    "scripts": {
        "build": "rolldown -c ./rolldown.config.ts"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "homepage": "https://mmjg-team.github.io/ui-components",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MMJG-Team/ui-components.git"
    },
    "keywords": [
        "frontend",
        "react",
        "ui",
        "component",
        "hooks",
        "masonry"
    ],
    "author": "MMJG-Team",
    "license": "ISC",
    "packageManager": "pnpm@10.12.1",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "classnames": "2.5.1",
        "lodash-es": "4.17.21",
        "mitt": "^3.0.1"
    },
    "devDependencies": {
        "@types/lodash-es": "4.17.12",
        "@types/node": "^25.9.3",
        "@types/react": "19.1.6",
        "@types/react-dom": "19.1.5",
        "axios": "1.9.0",
        "less": "^4.6.6",
        "react": "18.3.0",
        "react-dom": "18.3.0",
        "rolldown": "^1.1.1",
        "rolldown-plugin-dts": "^0.26.0",
        "rollup-plugin-postcss": "^4.0.2",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "axios": ">=1.9.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    }
}
